# ====================================
# EXAMPLE ENVIRONMENT VARIABLES
# Copy to .env and fill with real values
# NEVER commit .env to git!
# ====================================

# Database (Railway PostgreSQL auto-provides this)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT Secrets (Generate strong random strings!)
JWT_SECRET="generate-a-strong-random-secret-here"
JWT_REFRESH_SECRET="generate-another-strong-random-secret"

# Application
PORT=3000
NODE_ENV=production

# CORS (Your frontend URL)
CORS_ORIGIN=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ====================================
# EMAIL - RESEND API (Recommended for Railway)
# Railway blocks SMTP ports, use Resend instead
# Get API key from: https://resend.com/api-keys
# ====================================
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: If you have a verified domain on Resend
# RESEND_DOMAIN=yourdomain.com
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_OWNER_EMAIL=your-verified-email@example.com

# ====================================
# EMAIL - SMTP (Only for local development)
# DOES NOT WORK on Railway (ports blocked)
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

FROM_EMAIL=your-email@gmail.com
FROM_NAME=Your App Name

# Email Encryption Key (Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
ENCRYPTION_KEY=generate-32-char-hex-string-here

# ====================================
# ADMIN CREDENTIALS (Initial setup only)
# ====================================
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-secure-password

# ====================================
# AWS S3 (Optional - for file storage)
# ====================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# ====================================
# IMPORTANT RAILWAY NOTES:
# ====================================
# 1. Set all these in Railway Dashboard → Variables
# 2. DATABASE_URL is auto-provided by Railway PostgreSQL
# 3. PORT is auto-set by Railway
# 4. Use RESEND_API_KEY (SMTP won't work on Railway)
# 5. Never commit secrets to git!
